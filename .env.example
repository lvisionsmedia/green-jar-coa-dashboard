# Auth.js
AUTH_SECRET=generate-a-random-32-char-string
# Leave AUTH_URL unset in multi-tenant production so each subdomain is trusted.
AUTH_TRUST_HOST=true

# Platform admin (creates stores). Also used by db:init to seed green-jar store admin.
ADMIN_EMAIL=admin@thegreenjar.xyz
ADMIN_PASSWORD=change-me

# Vercel Blob (auto-provisioned on Vercel)
BLOB_READ_WRITE_TOKEN=

# Supabase (auto-provisioned via Vercel integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public apex site URL (store links use {slug}.host)
NEXT_PUBLIC_SITE_URL=https://thegreenjar.xyz
